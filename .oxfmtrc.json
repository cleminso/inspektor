{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "ignorePatterns": [
    "apps/inspector-test/**",
    "packages/jazz-dev-tools/**",
    "tools/oxlint/antiSlop/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.tsx"],
      "options": {
        "singleAttributePerLine": false
      }
    }
  ]
}
