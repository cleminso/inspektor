{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inspektor",
  "main": "./worker/siteWorker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "PRODUCT",
      "service": "inspektor-product"
    },
  ],
  "routes": [
    {
      "pattern": "inspektor.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false
}
