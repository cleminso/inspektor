{
  "name": "regarde.inspector",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "concurrently \"PORTLESS_PORT=1355 PORTLESS_HTTPS=1 portless inspector --force vite\" \"agentation-mcp server\" --names \"vite,agentation\" --prefix-colors \"cyan,magenta\"",
    "dev:vite": "concurrently \"vite\" \"agentation-mcp server\" --names \"vite,agentation\" --prefix-colors \"cyan,magenta\"",
    "portless:proxy": "portless proxy start --port 1355 --https",
    "build": "vite build && tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inspector/ds": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "agentation-mcp": "^1.2.0",
    "jazz-tools": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "agentation": "^3.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "portless": "^0.15.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  }
}
