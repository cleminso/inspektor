    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@stylexjs/unplugin": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/react": "catalog:",
