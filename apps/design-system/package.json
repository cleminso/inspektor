{
  "name": "inspektor.design-system",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=1 portless ui.inspektor --force vite",
    "build": "vite build && pnpm typecheck",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
