{
  "name": "inspector.design-system",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm gen:props && vite --host 0.0.0.0 --port 1356",
    "build": "pnpm check:props && vite build && pnpm typecheck",
    "check:props": "node scripts/extract-props.mjs --check",
    "gen:props": "node scripts/extract-props.mjs",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@inspector/ds": "workspace:*",
    "@shikijs/langs-precompiled": "3.23.0",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "ts-morph": "26.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
