{
  "name": "regarde-inspector",
  "version": "0.0.3",
  "private": true,
  "description": "Alternative inspector to the default Jazz-tools inspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/regardedev/inspector"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter regarde.inspector dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:handles": "pnpm --filter @inspector/ds exec vitest run src/tokens/tokens.stylex.test.ts --reporter=default --reporter=hanging-process",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "author": "cleminso",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  }
}
