{
  "name": "regarde-inspector",
  "version": "0.0.3",
  "private": true,
  "description": "Alternative inspector to the default Jazz-tools inspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/regardedev/inspector"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter regarde.inspector dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "inspector-test:deploy": "pnpm --filter inspector-test cloud:deploy",
    "inspector-test:fixture": "pnpm --filter inspector-test fixture:start",
    "inspector-test:initialize": "pnpm --filter inspector-test cloud:initialize",
    "inspector-test:seed": "pnpm --filter inspector-test cloud:seed",
    "inspector-test:validate": "pnpm --filter inspector-test cloud:validate",
    "test:browser": "pnpm --filter regarde.inspector test:browser",
    "test:browser:install": "pnpm --filter regarde.inspector test:browser:install",
    "test:design-system": "pnpm --filter @inspector/ds test",
    "test:design-system:node": "pnpm --filter @inspector/ds test:node",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && node --test tools/oxlint/antiSlop/rules/noDirectLucideJsx.test.mjs",
    "test:handles": "pnpm --filter @inspector/ds exec vitest run src/tokens/tokens.stylex.test.ts --reporter=default --reporter=hanging-process",
    "test:web": "pnpm --filter regarde.inspector test",
    "test:web:jsdom": "pnpm --filter regarde.inspector test:jsdom",
    "test:web:node": "pnpm --filter regarde.inspector test:node",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "author": "cleminso",
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  }
}
