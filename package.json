{
  "name": "inspektor",
  "version": "0.0.1",
  "private": true,
  "description": "Alternative inspektor to the default Jazz-tools Inspektor",
  "author": "cleminso",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleminso/inspektor"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:studio": "pnpm --filter inspektor dev",
    "dev:website": "pnpm --filter inspektor.website dev",
    "deploy:production": "pnpm --dir apps/studio deploy && pnpm --dir apps/website deploy",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "inspektor-test:deploy": "pnpm --filter inspektor-test cloud:deploy",
    "inspektor-test:fixture": "pnpm --filter inspektor-test fixture:start",
    "inspektor-test:initialize": "pnpm --filter inspektor-test cloud:initialize",
    "inspektor-test:seed": "pnpm --filter inspektor-test cloud:seed",
    "inspektor-test:validate": "pnpm --filter inspektor-test cloud:validate",
    "test:browser": "pnpm --filter inspektor test:browser",
    "test:browser:install": "pnpm --filter inspektor test:browser:install",
    "test:design-system": "pnpm --filter @inspektor/ds test",
    "test:design-system:node": "pnpm --filter @inspektor/ds test:node",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter='!inspektor.design-system' --filter='!inspektor-test' --workspace-concurrency=1 --if-present test && pnpm --filter inspektor-test test:root && node --test tools/oxlint/antiSlop/rules/noDirectLucideJsx.test.mjs",
    "test:handles": "pnpm --filter @inspektor/ds exec vitest run src/tokens/tokens.stylex.test.ts --reporter=default --reporter=hanging-process",
    "test:studio": "pnpm --filter inspektor test",
    "test:design-system-docs": "pnpm --filter inspektor.design-system test",
    "test:studio:jsdom": "pnpm --filter inspektor test:jsdom",
    "test:studio:node": "pnpm --filter inspektor test:node",
    "test:website": "pnpm --filter inspektor.website test",
    "test:website:browser": "pnpm --filter inspektor.website test:browser",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
