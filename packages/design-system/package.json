{
  "name": "@inspektor/ds",
  "version": "0.0.1",
  "private": true,
  "description": "Inspektor design system",
  "author": "Regarde",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleminso/inspektor.git",
    "directory": "packages/design-system"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/styles/baseline.css",
    "./dist/baseline.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "inspektor-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./brand": {
      "inspektor-source": "./src/brand/index.ts",
      "types": "./dist/brand/index.d.ts",
      "import": "./dist/brand/index.js",
      "default": "./dist/brand/index.js"
    },
    "./theme": {
      "inspektor-source": "./src/tokens/tokens.stylex.ts",
      "types": "./dist/tokens/tokens.stylex.d.ts",
      "import": "./dist/tokens/tokens.stylex.js",
      "default": "./dist/tokens/tokens.stylex.js"
    },
    "./theme-provider": {
      "inspektor-source": "./src/themeProvider/themeProvider.tsx",
      "types": "./dist/themeProvider/themeProvider.d.ts",
      "import": "./dist/themeProvider/themeProvider.js",
      "default": "./dist/themeProvider/themeProvider.js"
    },
    "./baseline.css": {
      "inspektor-source": "./src/styles/baseline.css",
      "default": "./dist/baseline.css"
    },
    "./tooltip": {
      "inspektor-source": "./src/studio/tooltip/tooltip.tsx",
      "types": "./dist/studio/tooltip/tooltip.d.ts",
      "import": "./dist/studio/tooltip/tooltip.js",
      "default": "./dist/studio/tooltip/tooltip.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsc -p tsconfig.build.json && node -e \"console.log('✓ Type check and declarations complete')\"",
    "build:runtime": "tsdown",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@lezer/highlight": "^1.2.3",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
