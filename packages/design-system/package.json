{
  "name": "@inspector/ds",
  "version": "0.0.1",
  "description": "Inspector design system",
  "author": "Regarde",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/regardedev/inspector.git",
    "directory": "packages/design-system"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./dist/tokens/tokens.stylex.d.ts",
      "default": "./src/tokens/tokens.stylex.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@stylexjs/stylex": "^0.19.0",
    "react-resizable-panels": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
