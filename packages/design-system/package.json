{
  "name": "@inspector/ds",
  "version": "0.0.1",
  "description": "Inspector design system",
  "author": "Regarde",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/regardedev/inspector.git",
    "directory": "packages/design-system"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./dist/tokens/tokens.stylex.d.ts",
      "default": "./src/tokens/tokens.stylex.ts"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "rm -rf dist && tsup",
    "lint": "oxlint .",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@stylexjs/stylex": "^0.19.0",
    "react-resizable-panels": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
